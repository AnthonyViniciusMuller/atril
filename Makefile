# Atril — development targets.
# Run `make help` for the annotated list.

FLUTTER ?= flutter
DART    ?= dart

# The Quire checkout the contract is vendored from. Phase 1 is what reads it.
QUIRE   ?= ../quire

# The entry point `run-linux` and `run-web` start. Phase 5 adds
# lib/main_development.dart — the one pointed at `make dev-up` next door — and
# makes it the default here; until then there is only one.
ENTRY   ?= lib/main.dart

# `flutter build macos` and `flutter build windows` need the host they target,
# so `build-all` builds what this machine can and leaves the rest to the six
# jobs in .github/workflows/ci.yml.
HOST    := $(shell uname -s)
ifeq ($(HOST),Darwin)
HOST_TARGETS := web android ios macos
else ifeq ($(findstring MINGW,$(HOST)),MINGW)
HOST_TARGETS := web windows
else
HOST_TARGETS := web android linux
endif

.DEFAULT_GOAL := help

## help: list the available targets
.PHONY: help
help:
	@grep -hE '^## ' $(MAKEFILE_LIST) | sed -E 's/^## ([a-z0-9-]+): /\1\t/' | awk -F '\t' '{printf "  \033[36m%-22s\033[0m %s\n", $$1, $$2}'

# --- code --------------------------------------------------------------------

## deps: resolve the pub dependencies
.PHONY: deps
deps:
	$(FLUTTER) pub get

# The contract is vendored into proto/quire/v1 rather than submoduled, for the
# reason quire/buf.gen.yaml gives on the other side: what is public is the
# contract, and a peer implements it from the .proto files rather than by
# importing anybody's generated types. A copy is only worth having if something
# notices when it stops matching, so there are two targets — one to refresh it
# and one to prove it has not drifted, which is what CI runs.
PROTO_DIR := proto/quire/v1

## proto-sync: refresh the vendored contract from a Quire checkout (QUIRE=../quire)
.PHONY: proto-sync
# The copy is deleted before it is written, for the reason buf.gen.yaml sets
# `clean: true` next door: a file dropped from the contract would otherwise
# survive here, be generated from, and be present on both sides of every drift
# check.
proto-sync: guard-quire
	@mkdir -p $(PROTO_DIR)
	@rm -f $(PROTO_DIR)/*.proto
	@cp $(QUIRE)/proto/quire/v1/*.proto $(PROTO_DIR)/
	@{ \
		echo '# The Quire commit this copy was refreshed from, recorded by `make'; \
		echo '# proto-sync`. It is provenance and not a pin: what CI enforces is that'; \
		echo "# the .proto files match Quire's main branch, not that this line is"; \
		echo '# current.'; \
		git -C $(QUIRE) rev-parse HEAD; \
	} > $(PROTO_DIR)/REVISION
	@echo "synced $(PROTO_DIR) from $(QUIRE) at $$(git -C $(QUIRE) rev-parse --short HEAD)"

## proto-check: fail when the vendored contract differs from a Quire checkout
.PHONY: proto-check
proto-check: guard-quire
	@diff -ru --exclude=REVISION $(PROTO_DIR) $(QUIRE)/proto/quire/v1 || { \
		echo "the vendored contract has drifted — run 'make proto-sync'" >&2; \
		exit 1; \
	}
	@echo "the vendored contract matches $(QUIRE)"

.PHONY: guard-quire
guard-quire:
	@test -d $(QUIRE)/proto/quire/v1 || { \
		echo "no contract under $(QUIRE) — point QUIRE at a Quire checkout" >&2; \
		exit 1; \
	}

# The Dart side of the contract is generated by protoc and protoc-gen-dart,
# both pinned. The output is committed, so the versions that produced it are
# part of the build rather than whatever a laptop happens to have: two protoc
# releases embed two different descriptors in the .pbjson.dart files, and the
# drift check CI runs would read that as a contract that had changed.
#
# `make tools` installs the plugin. protoc itself is expected on the PATH,
# because it is not a pub package; CI installs the pinned release.
PROTOC_VERSION        ?= 36.0
PROTOC_PLUGIN_VERSION ?= 25.0.0

PROTOC  ?= protoc
PUB_BIN := $(HOME)/.pub-cache/bin

# The generated code lives under the one service layer entitled to see it. The
# rule architecture.md states is that nothing above data/model imports a
# generated message, and putting the stubs inside data/services/api is what
# makes an import from elsewhere read as the mistake it is.
GEN_DIR := lib/data/services/api/generated

# The one proto in this repository that is not Quire's. google.rpc.ErrorInfo
# and google.rpc.BadRequest are what the node attaches to a status — the stable
# reason, and the fields that failed validation — and `package:grpc` parses
# them into types it does not export, under `src/`. Generating our own from the
# canonical file is what lets `data/services/api` read a rejected registration
# as something a form can point at, without importing another package's
# internals. It is vendored rather than depended on because there is no package
# on pub that publishes it alone.
GOOGLE_PROTO_DIR := proto/google/rpc

## tools: install the pinned code generators
.PHONY: tools
tools:
	$(DART) pub global activate protoc_plugin $(PROTOC_PLUGIN_VERSION)

# The output directory is emptied first, for the same reason proto-sync empties
# proto/quire/v1: a message deleted from the contract would otherwise leave a
# stub behind that still compiles and can still be imported.
#
# The formatter then runs over what protoc produced, rather than the output
# being excluded from formatting: `dart format --set-exit-if-changed .` is one
# of CI's checks and it has no exclusion list, so unformatted generated code is
# a red build with nothing wrong in it.
## gen: regenerate everything that is generated and committed
.PHONY: gen
gen: gen-proto gen-drift

## gen-proto: regenerate the dart stubs from the vendored contract
.PHONY: gen-proto
gen-proto:
	@command -v $(PROTOC) >/dev/null || { \
		echo "protoc is not on the PATH — install $(PROTOC_VERSION)" >&2; \
		exit 1; \
	}
	@PATH="$(PATH):$(PUB_BIN)" command -v protoc-gen-dart >/dev/null || { \
		echo "protoc-gen-dart is not installed — run 'make tools'" >&2; \
		exit 1; \
	}
	@rm -rf $(GEN_DIR)
	@mkdir -p $(GEN_DIR)
	@PATH="$(PATH):$(PUB_BIN)" $(PROTOC) -I proto --dart_out=grpc:$(GEN_DIR) \
		$(PROTO_DIR)/*.proto $(GOOGLE_PROTO_DIR)/*.proto
	@$(DART) format $(GEN_DIR) >/dev/null
	@echo "generated $(GEN_DIR) from $(PROTO_DIR)"

# drift's tables are Dart classes and everything that reads them — the row
# classes, the companions, the DAOs — is generated from those declarations into
# a .g.dart beside each one. The output is committed and checked in CI for the
# same reason the contract's is: a table edited without regenerating compiles
# against the previous shape and fails a long way from the edit.
#
## gen-drift: regenerate the drift database code
.PHONY: gen-drift
gen-drift:
	$(DART) run build_runner build

# The web build serves sqlite compiled to WebAssembly and drift's worker beside
# the app, because a browser has no file to open a database on. Neither can be
# built here and neither is on pub, so both are committed under web/ — see
# web/README.md — and both come from the one drift release, since the worker
# and the package talk a protocol versioned with drift.
#
# The pin below is what the committed files were downloaded for. It is checked
# against the drift pubspec.lock resolves rather than trusted: upgrading drift
# without refreshing the worker produces a build that compiles and then fails
# at its first statement, which is the failure worth spending a CI step on.
DRIFT_VERSION ?= 2.34.3
DRIFT_RELEASE := https://github.com/simolus3/drift/releases/download/drift-$(DRIFT_VERSION)

## web-assets: refresh sqlite3.wasm and drift_worker.js from the pinned drift release
.PHONY: web-assets
web-assets:
	@curl -fsSL -o web/sqlite3.wasm $(DRIFT_RELEASE)/sqlite3.wasm
	@curl -fsSL -o web/drift_worker.js $(DRIFT_RELEASE)/drift_worker.js
	@echo "web/sqlite3.wasm and web/drift_worker.js are from drift $(DRIFT_VERSION):"
	@shasum -a 256 web/sqlite3.wasm web/drift_worker.js 2>/dev/null \
		|| sha256sum web/sqlite3.wasm web/drift_worker.js

## web-assets-check: fail when the committed web assets are from another drift release
.PHONY: web-assets-check
web-assets-check:
	@resolved=$$(awk '/^  drift:$$/ { found = 1 } \
		found && /^    version:/ { gsub(/[":]/, "", $$2); print $$2; exit }' pubspec.lock); \
	test "$$resolved" = "$(DRIFT_VERSION)" || { \
		echo "pubspec.lock resolves drift $$resolved and web/ holds the assets of $(DRIFT_VERSION)" >&2; \
		echo "run 'make web-assets DRIFT_VERSION=$$resolved' and update web/README.md" >&2; \
		exit 1; \
	}
	@test -s web/sqlite3.wasm -a -s web/drift_worker.js || { \
		echo "web/sqlite3.wasm or web/drift_worker.js is missing — run 'make web-assets'" >&2; \
		exit 1; \
	}
	@echo "the web assets match drift $(DRIFT_VERSION)"

## fmt: format the Dart sources in place
.PHONY: fmt
fmt:
	$(DART) format .

# --- checks ------------------------------------------------------------------

## analyze: the formatter and the analyzer, as CI runs them
.PHONY: analyze
analyze:
	$(DART) format --output=none --set-exit-if-changed .
	$(FLUTTER) analyze

## test: the unit and widget tests
.PHONY: test
test:
	$(FLUTTER) test

# Generated code is not this project's code, and a percentage that counts it
# measures protoc and drift. lcov.info is a flat list of per-file records, so
# dropping one means dropping its SF: line and everything after it up to the
# next one.
## coverage: the tests with an lcov report, generated code excluded
.PHONY: coverage
coverage:
	$(FLUTTER) test --coverage
	@awk '/^SF:/ { skip = index($$0, "$(GEN_DIR)/") > 0 || /\.g\.dart$$/ } !skip' \
		coverage/lcov.info > coverage/lcov.info.filtered
	@mv coverage/lcov.info.filtered coverage/lcov.info
	@echo "coverage/lcov.info written, without the generated code"

# --- running -----------------------------------------------------------------

## run-linux: run against the local federation over the native gRPC lane
.PHONY: run-linux
run-linux:
	$(FLUTTER) run -d linux -t $(ENTRY)

## run-web: run against the local federation over the gRPC-Web lane
.PHONY: run-web
run-web:
	$(FLUTTER) run -d chrome -t $(ENTRY)

# --- building ----------------------------------------------------------------

## build-all: build every target this host can build (CI builds all six)
.PHONY: build-all
build-all: $(addprefix build-,$(HOST_TARGETS))
	@echo "built: $(HOST_TARGETS) — the rest are on CI"

.PHONY: build-web build-android build-linux build-macos build-ios build-windows
build-web:
	$(FLUTTER) build web
build-android:
	$(FLUTTER) build apk --debug
build-linux:
	$(FLUTTER) build linux --debug
build-macos:
	$(FLUTTER) build macos --debug
build-ios:
	$(FLUTTER) build ios --debug --no-codesign
build-windows:
	$(FLUTTER) build windows --debug

## clean: remove the build output
.PHONY: clean
clean:
	$(FLUTTER) clean
