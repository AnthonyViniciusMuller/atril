app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# `flutter build apk` writes here as well as to the root build directory.
/android/build/

# The Kotlin Gradle plugin's own session directory, written beside the build.
/android/.kotlin/

# The release signing material. `key.properties.example` is committed and says
# what belongs here; the keystore and the passwords never are.
/android/key.properties
*.jks
*.keystore
