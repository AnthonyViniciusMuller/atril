{
  "@@locale": "pt_BR",

  "appTitle": "Atril",
  "@appTitle": {
    "description": "O nome do aplicativo, como aparece na barra de título de uma janela, no seletor de aplicativos e na aba do navegador. É um nome próprio e não deve ser traduzido."
  },

  "navigationLibrary": "Biblioteca",
  "@navigationLibrary": {
    "description": "O destino de navegação que mostra o acervo do leitor. Rótulo curto, usado tanto na barra inferior de um celular quanto no trilho lateral de uma janela larga, e também como título da própria tela."
  },

  "navigationAnnotations": "Anotações",
  "@navigationAnnotations": {
    "description": "O destino de navegação que reúne os destaques, as notas e os marcadores que o leitor escreveu, de todos os livros. Rótulo curto, usado também como título da tela."
  },

  "navigationSettings": "Configurações",
  "@navigationSettings": {
    "description": "O destino de navegação que reúne a conta, os dispositivos, os servidores conhecidos e o estado da sincronização. Rótulo curto, usado também como título da tela."
  },

  "pageNotFoundTitle": "Página não encontrada",
  "@pageNotFoundTitle": {
    "description": "Título da tela mostrada quando o endereço aberto não corresponde a nenhuma rota. Acontece sobretudo no navegador, onde o leitor pode digitar ou colar um endereço, ou voltar a um que não existe mais."
  },

  "pageNotFoundMessage": "O endereço {location} não corresponde a nenhuma tela deste aplicativo.",
  "@pageNotFoundMessage": {
    "description": "Corpo da tela de endereço inexistente. Mostra o endereço pedido para que o leitor reconheça o que digitou ou de onde veio o link.",
    "placeholders": {
      "location": {
        "type": "String",
        "example": "/biblioteca/42"
      }
    }
  },

  "pageNotFoundAction": "Ir para a biblioteca",
  "@pageNotFoundAction": {
    "description": "Botão da tela de endereço inexistente, que leva o leitor de volta ao acervo. É a única saída oferecida, porque um endereço inválido não tem histórico para onde voltar."
  },

  "onboardingServerTitle": "Escolha seu servidor",
  "@onboardingServerTitle": {
    "description": "Título da primeira tela que uma instalação nova mostra. O leitor escolhe em qual servidor Quire sua biblioteca fica, o que é a metade do identificador dele que diz onde ele está — não é uma preferência que possa ser adiada."
  },

  "onboardingServerExplanation": "Sua biblioteca fica em um servidor Quire. O endereço dele é a segunda metade do seu identificador, como em @ana:quire.exemplo.",
  "@onboardingServerExplanation": {
    "description": "Parágrafo abaixo do título da tela de escolha de servidor. Explica por que a pergunta está sendo feita antes de qualquer outra, usando um identificador federado de exemplo."
  },

  "onboardingServerFieldLabel": "Domínio do servidor",
  "@onboardingServerFieldLabel": {
    "description": "Rótulo do campo onde o leitor digita o domínio do servidor, como quire.exemplo. É um domínio e não uma URL: o aplicativo descobre o resto lendo o documento que o servidor publica."
  },

  "onboardingServerFieldHint": "quire.exemplo",
  "@onboardingServerFieldHint": {
    "description": "Texto de exemplo dentro do campo de domínio, mostrado enquanto ele está vazio. É um domínio de exemplo e não deve ser traduzido para algo que pareça um endereço real."
  },

  "onboardingServerContinue": "Continuar",
  "@onboardingServerContinue": {
    "description": "Botão que busca o documento de descoberta do domínio digitado e passa a usar aquele servidor. Rótulo curto."
  },

  "onboardingServerDevelopment": "Federação de desenvolvimento",
  "@onboardingServerDevelopment": {
    "description": "Título da lista de servidores que uma compilação de depuração já sabe alcançar — os dois nós que o `make dev-up` do Quire sobe ao lado. Não aparece em uma compilação de produção."
  },

  "onboardingServerChosen": "Você vai entrar em {domain}.",
  "@onboardingServerChosen": {
    "description": "Confirmação mostrada depois que a descoberta deu certo, nomeando o servidor que o aplicativo passou a usar.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerNotQuire": "{domain} não publica um documento de descoberta do Quire.",
  "@onboardingServerNotQuire": {
    "description": "Erro mostrado quando o domínio respondeu, mas com algo que não é um servidor Quire — inclusive um 404, que é um host que não é um nó. O leitor deve conferir o que digitou.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerUnreachable": "{domain} não respondeu. Verifique sua conexão e tente de novo.",
  "@onboardingServerUnreachable": {
    "description": "Erro mostrado quando o domínio não respondeu à busca: sem rota, sem resposta ou tempo esgotado. É o único dos erros desta tela em que tentar de novo pode dar certo sem mudar nada.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerInsecure": "A busca por {domain} foi redirecionada para uma conexão sem criptografia e foi recusada.",
  "@onboardingServerInsecure": {
    "description": "Erro mostrado quando a busca foi redirecionada para http simples. O documento vale exatamente o que vale o canal por onde ele chegou, então o aplicativo recusa em vez de seguir.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerFailed": "Não foi possível usar {domain}.",
  "@onboardingServerFailed": {
    "description": "Erro genérico da tela de escolha de servidor, para uma falha que não é nenhuma das outras três. O detalhe fica no log, que é onde ele pode ser lido por quem investiga.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  }
}
