{
  "@@locale": "pt_BR",

  "appTitle": "Atril",
  "@appTitle": {
    "description": "O nome do aplicativo, como aparece na barra de título de uma janela, no seletor de aplicativos e na aba do navegador. É um nome próprio e não deve ser traduzido."
  },

  "navigationLibrary": "Biblioteca",
  "@navigationLibrary": {
    "description": "O destino de navegação que mostra o acervo do leitor. Rótulo curto, usado tanto na barra inferior de um celular quanto no trilho lateral de uma janela larga, e também como título da própria tela."
  },

  "navigationAnnotations": "Anotações",
  "@navigationAnnotations": {
    "description": "O destino de navegação que reúne os destaques, as notas e os marcadores que o leitor escreveu, de todos os livros. Rótulo curto, usado também como título da tela."
  },

  "navigationSettings": "Configurações",
  "@navigationSettings": {
    "description": "O destino de navegação que reúne a conta, os dispositivos, os servidores conhecidos e o estado da sincronização. Rótulo curto, usado também como título da tela."
  },

  "pageNotFoundTitle": "Página não encontrada",
  "@pageNotFoundTitle": {
    "description": "Título da tela mostrada quando o endereço aberto não corresponde a nenhuma rota. Acontece sobretudo no navegador, onde o leitor pode digitar ou colar um endereço, ou voltar a um que não existe mais."
  },

  "pageNotFoundMessage": "O endereço {location} não corresponde a nenhuma tela deste aplicativo.",
  "@pageNotFoundMessage": {
    "description": "Corpo da tela de endereço inexistente. Mostra o endereço pedido para que o leitor reconheça o que digitou ou de onde veio o link.",
    "placeholders": {
      "location": {
        "type": "String",
        "example": "/biblioteca/42"
      }
    }
  },

  "pageNotFoundAction": "Ir para a biblioteca",
  "@pageNotFoundAction": {
    "description": "Botão da tela de endereço inexistente, que leva o leitor de volta ao acervo. É a única saída oferecida, porque um endereço inválido não tem histórico para onde voltar."
  },

  "onboardingServerTitle": "Escolha seu servidor",
  "@onboardingServerTitle": {
    "description": "Título da primeira tela que uma instalação nova mostra. O leitor escolhe em qual servidor Quire sua biblioteca fica, o que é a metade do identificador dele que diz onde ele está — não é uma preferência que possa ser adiada."
  },

  "onboardingServerExplanation": "Sua biblioteca fica em um servidor Quire. O endereço dele é a segunda metade do seu identificador, como em @ana:quire.exemplo.",
  "@onboardingServerExplanation": {
    "description": "Parágrafo abaixo do título da tela de escolha de servidor. Explica por que a pergunta está sendo feita antes de qualquer outra, usando um identificador federado de exemplo."
  },

  "onboardingServerFieldLabel": "Domínio do servidor",
  "@onboardingServerFieldLabel": {
    "description": "Rótulo do campo onde o leitor digita o domínio do servidor, como quire.exemplo. É um domínio e não uma URL: o aplicativo descobre o resto lendo o documento que o servidor publica."
  },

  "onboardingServerFieldHint": "quire.exemplo",
  "@onboardingServerFieldHint": {
    "description": "Texto de exemplo dentro do campo de domínio, mostrado enquanto ele está vazio. É um domínio de exemplo e não deve ser traduzido para algo que pareça um endereço real."
  },

  "onboardingServerContinue": "Continuar",
  "@onboardingServerContinue": {
    "description": "Botão que busca o documento de descoberta do domínio digitado e passa a usar aquele servidor. Rótulo curto."
  },

  "onboardingServerDevelopment": "Federação de desenvolvimento",
  "@onboardingServerDevelopment": {
    "description": "Título da lista de servidores que uma compilação de depuração já sabe alcançar — os dois nós que o `make dev-up` do Quire sobe ao lado. Não aparece em uma compilação de produção."
  },

  "onboardingServerChosen": "Você vai entrar em {domain}.",
  "@onboardingServerChosen": {
    "description": "Confirmação mostrada depois que a descoberta deu certo, nomeando o servidor que o aplicativo passou a usar.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerNotQuire": "{domain} não publica um documento de descoberta do Quire.",
  "@onboardingServerNotQuire": {
    "description": "Erro mostrado quando o domínio respondeu, mas com algo que não é um servidor Quire — inclusive um 404, que é um host que não é um nó. O leitor deve conferir o que digitou.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerUnreachable": "{domain} não respondeu. Verifique sua conexão e tente de novo.",
  "@onboardingServerUnreachable": {
    "description": "Erro mostrado quando o domínio não respondeu à busca: sem rota, sem resposta ou tempo esgotado. É o único dos erros desta tela em que tentar de novo pode dar certo sem mudar nada.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerInsecure": "A busca por {domain} foi redirecionada para uma conexão sem criptografia e foi recusada.",
  "@onboardingServerInsecure": {
    "description": "Erro mostrado quando a busca foi redirecionada para http simples. O documento vale exatamente o que vale o canal por onde ele chegou, então o aplicativo recusa em vez de seguir.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerFailed": "Não foi possível usar {domain}.",
  "@onboardingServerFailed": {
    "description": "Erro genérico da tela de escolha de servidor, para uma falha que não é nenhuma das outras três. O detalhe fica no log, que é onde ele pode ser lido por quem investiga.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "onboardingServerConfirm": "Continuar em {domain}",
  "@onboardingServerConfirm": {
    "description": "Botão que leva o leitor da tela de escolha de servidor para a tela de entrada, nomeando o servidor escolhido. Só aparece depois que a descoberta deu certo.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "signInTitle": "Entrar",
  "@signInTitle": {
    "description": "Título da tela de entrada, onde o leitor se autentica no servidor que escolheu. Também é o rótulo do botão que envia o formulário."
  },

  "signInAt": "Entrando em {domain}.",
  "@signInAt": {
    "description": "Linha abaixo do título da tela de entrada, nomeando o servidor a que as credenciais serão enviadas. Está ali porque a senha vai para esse servidor e para nenhum outro.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "signInIdentifierLabel": "Nome de usuário ou e-mail",
  "@signInIdentifierLabel": {
    "description": "Rótulo do campo onde o leitor se identifica. O contrato aceita as duas metades — o nome local ou o endereço — e é o cliente que decide qual foi digitado, porque um nome local não pode conter arroba e um endereço precisa."
  },

  "signInPasswordLabel": "Senha",
  "@signInPasswordLabel": {
    "description": "Rótulo do campo de senha da tela de entrada."
  },

  "signInPasswordShow": "Mostrar a senha",
  "@signInPasswordShow": {
    "description": "Botão dentro do campo de senha que revela o que foi digitado. É o rótulo lido em voz alta pelo leitor de tela e a dica que aparece ao parar o cursor sobre o ícone, então descreve o que o botão faz e não o estado atual do campo."
  },

  "signInPasswordHide": "Ocultar a senha",
  "@signInPasswordHide": {
    "description": "O mesmo botão enquanto a senha está visível, quando tocá-lo volta a escondê-la."
  },

  "signInSubmit": "Entrar",
  "@signInSubmit": {
    "description": "Botão que envia as credenciais ao servidor escolhido. Rótulo curto."
  },


  "signInInvalidCredentials": "Nome de usuário ou senha incorretos.",
  "@signInInvalidCredentials": {
    "description": "Erro mostrado quando o servidor recusou as credenciais. É deliberadamente o mesmo texto para um leitor que não existe e para uma senha errada: dizer qual das duas falhou permitiria descobrir quem tem conta no servidor."
  },

  "signInDeviceRevoked": "Este dispositivo foi desvinculado da conta. Peça a outro dispositivo para vinculá-lo de novo.",
  "@signInDeviceRevoked": {
    "description": "Erro mostrado quando o servidor reconheceu as credenciais mas recusou este dispositivo, porque ele foi desvinculado. O registro dele continua existindo, então a saída é vincular de novo a partir de um dispositivo já autenticado."
  },

  "signInUnreachable": "Não foi possível falar com {domain}. Verifique sua conexão e tente de novo.",
  "@signInUnreachable": {
    "description": "Erro mostrado quando o servidor não respondeu à tentativa de entrada. É o único erro desta tela em que tentar de novo pode dar certo sem mudar nada.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "signInFailed": "Não foi possível entrar.",
  "@signInFailed": {
    "description": "Erro genérico da tela de entrada, para uma falha que não é nenhuma das outras. O detalhe fica no log, que é onde quem investiga pode lê-lo."
  },

  "deviceDefaultName": "Atril em {platform}",
  "@deviceDefaultName": {
    "description": "O nome que este dispositivo recebe na lista de dispositivos do leitor quando ele é vinculado pela primeira vez. O parâmetro é o nome próprio da plataforma — Android, iOS, Web, Linux, macOS, Windows — que não se traduz; o que esta mensagem decide é a frase em volta dele.",
    "placeholders": {
      "platform": {
        "type": "String",
        "example": "Linux"
      }
    }
  },

  "signInRegister": "Criar uma conta",
  "@signInRegister": {
    "description": "Ação secundária da tela de entrada, para quem ainda não tem conta no servidor escolhido. Leva à tela de cadastro."
  },

  "registerTitle": "Criar uma conta",
  "@registerTitle": {
    "description": "Título da tela de cadastro, onde o leitor cria uma conta no servidor que escolheu."
  },

  "registerAt": "A conta será criada em {domain}, e seu identificador será @nome:{domain}.",
  "@registerAt": {
    "description": "Linha abaixo do título da tela de cadastro. Nomeia o servidor e explica que o domínio dele passa a ser a segunda metade do identificador do leitor — não é uma escolha que possa ser mudada depois sem migrar de servidor.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "registerLocalNameLabel": "Nome de usuário",
  "@registerLocalNameLabel": {
    "description": "Rótulo do campo do nome local, a primeira metade do identificador federado. Só aceita letras minúsculas, dígitos e os separadores ponto, hífen e sublinhado, porque o valor vai embutido em URLs, em tokens e em buscas .well-known."
  },

  "registerDisplayNameLabel": "Nome exibido",
  "@registerDisplayNameLabel": {
    "description": "Rótulo do campo do nome que o leitor quer que apareça. É o único nome pensado para ser mostrado, e aceita qualquer texto."
  },

  "registerEmailLabel": "E-mail",
  "@registerEmailLabel": {
    "description": "Rótulo do campo de endereço. É para onde a recuperação de senha é enviada, e é o único dado pessoal que não sai do servidor de origem."
  },

  "registerPasswordLabel": "Senha",
  "@registerPasswordLabel": {
    "description": "Rótulo do campo de senha da tela de cadastro."
  },

  "registerSubmit": "Criar conta",
  "@registerSubmit": {
    "description": "Botão que envia o cadastro ao servidor escolhido. Rótulo curto."
  },

  "registerLocalNameInvalid": "Use apenas letras minúsculas, dígitos e . - _, começando e terminando com letra ou dígito.",
  "@registerLocalNameInvalid": {
    "description": "Erro do campo de nome de usuário quando ele não tem a forma que o servidor aceita. Diz a regra inteira em vez de qual parte foi quebrada, porque a regra é curta e o leitor precisa dela para corrigir."
  },

  "registerLocalNameTaken": "Esse nome já é de outra pessoa neste servidor. O mesmo nome em outro servidor está livre.",
  "@registerLocalNameTaken": {
    "description": "Erro do campo de nome de usuário quando o servidor recusou por já existir. A segunda frase não é consolo: em uma federação, o identificador só é único dentro de um servidor."
  },

  "registerDisplayNameInvalid": "O nome exibido não pode ficar em branco.",
  "@registerDisplayNameInvalid": {
    "description": "Erro do campo de nome exibido. É o único caso que o esquema não recusa sozinho, e um nome em branco deixaria o leitor sem nada para mostrar."
  },

  "registerEmailInvalid": "Digite um endereço de e-mail válido.",
  "@registerEmailInvalid": {
    "description": "Erro do campo de e-mail quando o endereço não tem a forma mínima que o servidor aceita: algo, uma arroba, algo."
  },

  "registerEmailTaken": "Esse endereço já está cadastrado neste servidor.",
  "@registerEmailTaken": {
    "description": "Erro do campo de e-mail quando o servidor recusou por já existir."
  },

  "registerPasswordInvalid": "A senha precisa ter pelo menos 8 caracteres.",
  "@registerPasswordInvalid": {
    "description": "Erro do campo de senha. O piso de oito caracteres é o que a NIST SP 800-63B pede de um segredo memorizado; a mensagem não pede maiúsculas nem símbolos porque o mesmo documento retirou essa exigência."
  },

  "registerFailed": "Não foi possível criar a conta.",
  "@registerFailed": {
    "description": "Erro geral da tela de cadastro, para uma falha que nenhum campo explica. O detalhe fica no log."
  },

  "registerUnreachable": "Não foi possível falar com {domain}. Verifique sua conexão e tente de novo.",
  "@registerUnreachable": {
    "description": "Erro geral da tela de cadastro quando o servidor não respondeu. É o único desta tela em que tentar de novo pode dar certo sem mudar nada.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "settingsAccountSection": "Conta",
  "@settingsAccountSection": {
    "description": "Título da seção da tela de configurações que reúne o que diz respeito à conta do leitor. As demais seções — dispositivos, servidores conhecidos, sincronização — chegam nas fases seguintes."
  },

  "settingsSignedInAs": "Você está em {federatedId}.",
  "@settingsSignedInAs": {
    "description": "Linha que nomeia o leitor conectado pelo identificador federado inteiro, com as duas metades. Está ali porque o identificador diz também em qual servidor a biblioteca está, e o leitor pode ter contas em mais de um.",
    "placeholders": {
      "federatedId": {
        "type": "String",
        "example": "@ana:quire-a.example"
      }
    }
  },

  "settingsSignOut": "Sair",
  "@settingsSignOut": {
    "description": "Ação que encerra a sessão neste dispositivo. Rótulo curto."
  },

  "settingsSignOutExplanation": "Sua biblioteca continua neste dispositivo. Sair encerra a sessão e não apaga nada.",
  "@settingsSignOutExplanation": {
    "description": "Explicação abaixo da ação de sair. Diz o que sair não faz, porque o leitor não tem como saber: o acervo, as anotações e as mudanças ainda não enviadas continuam no dispositivo, e é isso que faz com que entrar de novo devolva a biblioteca em vez de uma vazia."
  },

  "signInForgot": "Esqueci minha senha",
  "@signInForgot": {
    "description": "Ação secundária da tela de entrada, para quem não lembra a senha. Leva à tela que pede o envio de um código de recuperação."
  },

  "recoveryTitle": "Recuperar a senha",
  "@recoveryTitle": {
    "description": "Título da tela que pede o envio de um código de recuperação para o endereço cadastrado."
  },

  "recoveryExplanation": "Informe o e-mail da sua conta em {domain}. Se houver uma conta com esse endereço, enviaremos um código para redefinir a senha.",
  "@recoveryExplanation": {
    "description": "Parágrafo da tela de recuperação. A frase é condicional de propósito: o servidor responde a mesma coisa exista ou não a conta, e uma tela que dissesse o contrário transformaria este formulário em uma forma de descobrir quem tem conta ali.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "recoveryEmailLabel": "E-mail",
  "@recoveryEmailLabel": {
    "description": "Rótulo do campo de endereço na tela de recuperação."
  },

  "recoverySubmit": "Enviar código",
  "@recoverySubmit": {
    "description": "Botão que pede ao servidor o envio do código de recuperação. Rótulo curto."
  },

  "recoverySent": "Se houver uma conta com esse endereço, o código já está a caminho. Confira também a caixa de spam.",
  "@recoverySent": {
    "description": "Confirmação mostrada depois do pedido. Diz o mesmo exista ou não a conta — é a mesma promessa que o servidor faz, e uma confirmação que só aparecesse para endereços cadastrados diria por omissão exatamente o que a tela não deve dizer."
  },

  "recoveryHaveCode": "Já tenho um código",
  "@recoveryHaveCode": {
    "description": "Ação que leva à tela de redefinição, para quem já recebeu o código por e-mail. Está aqui porque o código chega em outro dispositivo tão frequentemente quanto neste."
  },

  "recoveryUnreachable": "Não foi possível falar com {domain}. Verifique sua conexão e tente de novo.",
  "@recoveryUnreachable": {
    "description": "Erro mostrado quando o servidor não respondeu ao pedido de recuperação.",
    "placeholders": {
      "domain": {
        "type": "String",
        "example": "quire-a.example"
      }
    }
  },

  "recoveryFailed": "Não foi possível pedir a recuperação.",
  "@recoveryFailed": {
    "description": "Erro geral da tela de recuperação, para uma falha que o campo de e-mail não explica."
  },

  "resetTitle": "Definir uma nova senha",
  "@resetTitle": {
    "description": "Título da tela que troca a senha usando o código recebido por e-mail."
  },

  "resetExplanation": "Cole o código que você recebeu por e-mail e escolha uma nova senha. Todas as sessões de todos os seus dispositivos serão encerradas.",
  "@resetExplanation": {
    "description": "Parágrafo da tela de redefinição. A segunda frase é um aviso e não um detalhe: quem redefine a senha perdeu o controle da anterior, e deixar vivas as sessões que ela abriu deixaria conectado quem a tomou."
  },

  "resetTokenLabel": "Código de recuperação",
  "@resetTokenLabel": {
    "description": "Rótulo do campo onde o leitor cola o código recebido por e-mail."
  },

  "resetPasswordLabel": "Nova senha",
  "@resetPasswordLabel": {
    "description": "Rótulo do campo da nova senha na tela de redefinição."
  },

  "resetSubmit": "Redefinir senha",
  "@resetSubmit": {
    "description": "Botão que gasta o código e grava a nova senha. Rótulo curto."
  },

  "resetTokenInvalid": "Esse código não vale. Ele pode ter expirado ou já ter sido usado — peça outro.",
  "@resetTokenInvalid": {
    "description": "Erro do campo de código. O servidor responde a mesma coisa para um código que nunca existiu, um já gasto, um expirado e um de outra conta, porque distinguir seria contar algo sobre uma conta que quem pergunta não provou ser sua; a mensagem repete essa indistinção em vez de inventar uma explicação."
  },

  "resetDone": "Senha redefinida. Entre com a nova senha.",
  "@resetDone": {
    "description": "Confirmação mostrada depois da redefinição, na tela de entrada para onde o leitor é levado."
  },

  "resetFailed": "Não foi possível redefinir a senha.",
  "@resetFailed": {
    "description": "Erro geral da tela de redefinição, para uma falha que nenhum dos dois campos explica."
  },

  "libraryEmptyTitle": "Sua biblioteca está vazia",
  "@libraryEmptyTitle": {
    "description": "Título do estado vazio da tela da biblioteca, mostrado a quem ainda não importou nenhum livro. É a primeira tela que um leitor recém-cadastrado vê depois de entrar."
  },

  "libraryEmptyMessage": "Importe um arquivo EPUB, PDF, MOBI, DJVU ou CBZ. Ele fica guardado neste dispositivo e é enviado ao seu servidor quando houver rede.",
  "@libraryEmptyMessage": {
    "description": "Corpo do estado vazio da biblioteca. Diz o que fazer em seguida e, de passagem, a promessa central do aplicativo: o livro é gravado aqui primeiro e sincronizado depois, então importar sem rede funciona."
  },

  "libraryFilterEmptyTitle": "Nenhum livro nesta estante",
  "@libraryFilterEmptyTitle": {
    "description": "Título mostrado quando o leitor tem livros, mas nenhum deles está arquivado na estante escolhida. É diferente do estado vazio da biblioteca inteira: aqui o acervo não está vazio, o filtro é que não encontrou nada."
  },

  "libraryFilterEmptyMessage": "Você tem livros, mas nenhum está arquivado aqui.",
  "@libraryFilterEmptyMessage": {
    "description": "Corpo do estado vazio de uma estante, acompanhado do botão que volta para o acervo inteiro."
  },

  "libraryShowAll": "Todos os livros",
  "@libraryShowAll": {
    "description": "Rótulo do filtro que mostra o acervo inteiro, sem estante nenhuma escolhida. Aparece como o primeiro de uma fileira de estantes e também como o botão de saída do estado vazio de uma estante."
  },

  "librarySort": "Ordenar",
  "@librarySort": {
    "description": "Rótulo do menu que escolhe a ordem da lista de livros. Rótulo curto, usado como dica do botão."
  },

  "librarySortRecent": "Adicionados recentemente",
  "@librarySortRecent": {
    "description": "Opção de ordenação: o livro importado mais recentemente primeiro. É a ordem padrão, porque num acervo que cresce por importação a chegada mais nova é a mais procurada."
  },

  "librarySortTitle": "Título",
  "@librarySortTitle": {
    "description": "Opção de ordenação: em ordem alfabética de título."
  },

  "librarySortAuthor": "Autor",
  "@librarySortAuthor": {
    "description": "Opção de ordenação: em ordem alfabética de autor. Os livros cujo arquivo não disse o autor ficam no fim."
  },

  "libraryUnknownAuthor": "Autor desconhecido",
  "@libraryUnknownAuthor": {
    "description": "Mostrado no lugar do autor quando o arquivo não disse qual é. É diferente de um autor em branco: um é ausência de informação e o outro seria uma afirmação de que não há autor."
  },

  "libraryReadFailed": "Não foi possível ler sua biblioteca neste dispositivo.",
  "@libraryReadFailed": {
    "description": "Erro mostrado quando a consulta ao banco local falha. Não tem nada a ver com rede: o acervo é lido daqui, então uma falha aqui é do próprio dispositivo."
  },

  "libraryBookCount": "{count, plural, =0{Nenhum livro} =1{1 livro} other{{count} livros}}",
  "@libraryBookCount": {
    "description": "Quantos livros a listagem atual tem. Aparece abaixo do título da tela e ao lado do nome de uma estante.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "libraryImport": "Importar um livro",
  "@libraryImport": {
