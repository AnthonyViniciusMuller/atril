<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Brazilian Portuguese, because that is this app's default locale and
	     English is its second. The template leaves this as the Xcode variable,
	     which resolves to `en`, and the consequence is not cosmetic: the share
	     sheet the export of phase 10 goes through on this target is laid out
	     by the system, in the language the *bundle* says it develops in, and
	     `share_plus` documents this key and the one below as the fix for a
	     sheet that appears in the wrong one. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!-- What this bundle is offered in. iOS decides an app's language from the
	     localizations it declares, and a Flutter app declares none of its own —
	     the ARB files are compiled into Dart and the system never sees them.
	     Without this key a device set to Portuguese is served the development
	     region and nothing else, which is the one language this app is
	     *written* in being the one it cannot be asked for.

	     Both entries are here rather than `pt` alone, in the order the app
	     supports them. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>pt-BR</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Atril</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Atril</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- `ITSAppUsesNonExemptEncryption` is deliberately absent, and its absence
	     costs one question per upload rather than being an oversight. The
	     template's answer is `false`, which claims the app uses only the
	     encryption the operating system provides — and this one does not: the
	     native lane's TLS is BoringSSL inside the Dart runtime, not Apple's.
	     Whether that still falls under an exemption is a declaration the
	     publisher makes, not a fact a build file can assert on their behalf,
	     so App Store Connect asks and a person answers. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
